# Copiar a .env (nunca versionar .env). Valores de ejemplo, no reales.
DJANGO_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
# 1 solo en desarrollo local (habilita SQLite y desactiva la redirección a HTTPS).
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.ejemplo.cl
# Neon: copiar la cadena desde el panel (Connect). TLS es obligatorio (sslmode=require).
#  - API (Render): host con `-pooler`.
#  - Respaldo con pg_dump: host directo, sin `-pooler`.
DATABASE_URL=postgresql://usuario:clave@ep-ejemplo-123-pooler.sa-east-1.aws.neon.tech/to_clinica?sslmode=require
# Clave AES-256 del respaldo (64 hex): python -c "import secrets; print(secrets.token_hex(32))"
RESPALDO_CLAVE_HEX=
