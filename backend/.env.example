# Copiar a .env (nunca versionar .env). Valores de ejemplo, no reales.
DJANGO_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
# 1 solo en desarrollo local (habilita SQLite y desactiva la redirección a HTTPS).
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.ejemplo.cl
DATABASE_URL=postgres://usuario:clave@localhost:5432/to_clinica
